/* ============================================================
   桌面AI助手 - 全局样式表
   毛玻璃 / 漫画气泡 / 信息卡片 / 设置窗口
   ============================================================ */

/* ---------- 毛玻璃输入条 ---------- */
#inputPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 235), stop:1 rgba(255, 248, 236, 225));
    border: 1.5px solid rgba(255, 178, 92, 210);
    border-radius: 18px;
}
#inputEdit {
    background: rgba(255, 255, 255, 160);
    border: 1px solid rgba(232, 185, 106, 130);
    border-radius: 12px;
    padding: 0 12px;
    font-size: 15px;
    color: #3a2d20;
    font-family: "Microsoft YaHei", sans-serif;
    selection-background-color: #ffd9a0;
}
#inputEdit:focus {
    border: 1.5px solid rgba(224, 123, 57, 200);
    background: rgba(255, 255, 255, 235);
}
#inputEdit::placeholder {
    color: rgba(120, 100, 80, 160);
    font-size: 13px;
}
#barButton {
    background-color: rgba(255, 238, 211, 200);
    border: 1px solid rgba(240, 201, 135, 220);
    border-radius: 10px;
    color: #8a6a44;
    font-size: 13px;
    font-weight: bold;
    padding: 0 10px;
}
#barButton:hover {
    background-color: #ffd9a0;
    color: #6b4e2e;
}
#sendButton {
    background-color: #ffb25c;
    border: none;
    border-radius: 12px;
    color: white;
    font-size: 14px;
    font-weight: bold;
    padding: 0 14px;
}
#sendButton:hover { background-color: #e89a3e; }
#sendButton:pressed { background-color: #d18a30; }

/* ---------- 聊天记录面板（独立窗口） ---------- */
#historyPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 253, 248, 248), stop:1 rgba(255, 246, 232, 242));
    border: 1.5px solid rgba(240, 201, 135, 230);
    border-radius: 16px;
}
#historyTitle {
    color: #e07b39;
    font-size: 22px;
    font-weight: bold;
    font-family: "Microsoft YaHei", sans-serif;
}
#historyTip {
    color: #b0a08c;
    font-size: 15px;
    padding-top: 2px;
}
#historyClose {
    background: transparent; border: none; border-radius: 12px;
    color: #a0907f; font-size: 19px; font-weight: bold;
    padding: 2px 8px;
}
#historyClose:hover { background-color: #f5e3c5; color: #e0553c; }

/* ---------- 历史记录列表 ---------- */
#historyList {
    background-color: rgba(255, 252, 246, 240);
    border: 1px solid rgba(232, 185, 106, 150);
    border-radius: 10px;
    outline: none;
    font-size: 19px;
}
#historyList::item { border-bottom: 1px solid rgba(232, 185, 106, 60); }
#historyList::item:selected { background-color: #ffeed3; }
#historyItem { background: transparent; }
#historyIcon { font-size: 21px; }
#historyNameUser { color: #6b8f5a; font-weight: bold; font-size: 18px; }
#historyNamePet { color: #e07b39; font-weight: bold; font-size: 18px; }
#historyTime { color: #a0907f; font-size: 16px; }
#historyTextUser {
    color: #3a2d20; font-size: 19px;
    background-color: rgba(233, 242, 224, 220);
    border: 1px solid rgba(107, 143, 90, 90);
    border-radius: 10px;
    padding: 9px 13px;
}
#historyTextPet {
    color: #3a2d20; font-size: 19px;
    background-color: rgba(255, 237, 211, 230);
    border: 1px solid rgba(232, 150, 60, 90);
    border-radius: 10px;
    padding: 9px 13px;
}
#sessionHeader {
    color: #976f3f; font-size: 16px; padding: 6px 8px;
    background-color: rgba(240, 220, 190, 140);
}
#historyCount { color: #8a6a44; font-size: 16px; }
#historyClear {
    background: transparent; border: none;
    color: #a0907f; font-size: 16px;
}
#historyClear:hover { color: #e0553c; }
#historyItemBtn {
    background: transparent; border: none; border-radius: 8px;
    color: #b0a08c; font-size: 15px; padding: 1px 6px;
}
#historyItemBtn:hover { background-color: #f5e3c5; color: #8a6a44; }
#historyItemBtn[role="delete"] { color: #c9a08f; }
#historyItemBtn[role="delete"]:hover { background-color: #f8ddd2; color: #e0553c; }

/* ---------- 漫画对话气泡 ---------- */
#bubblePanel {
    background-color: rgba(255, 255, 255, 245);
    border: 2px solid #e8b96a;
    border-radius: 16px;
}
#bubbleLabel {
    background: transparent;
    color: #3a2d20;
    font-size: 18px;
    font-family: "Microsoft YaHei", sans-serif;
}

/* ---------- 信息卡片 ---------- */
#cardPanel {
    background-color: rgba(255, 255, 255, 250);
    border: 2px solid #f0c987;
    border-radius: 14px;
}
#cardTitle {
    color: #e07b39;
    font-size: 16px;
    font-weight: bold;
    font-family: "Microsoft YaHei", sans-serif;
}
#cardPath, #cardSize {
    color: #6b5d4d;
    font-size: 12px;
    font-family: "Consolas", "Microsoft YaHei", monospace;
}
#cardClose {
    background: transparent;
    border: none;
    color: #b0a090;
    font-size: 14px;
    font-weight: bold;
}
#cardClose:hover {
    color: #e07b39;
}

/* ---------- 设置窗口 ---------- */
#settingsPanel {
    background-color: #fffaf2;
    border: 1px solid #e8cfa5;
    border-radius: 12px;
}
#settingsTitle {
    color: #e07b39;
    font-size: 18px;
    font-weight: bold;
    font-family: "Microsoft YaHei", sans-serif;
}
QLabel {
    color: #5a4a38;
    font-family: "Microsoft YaHei", sans-serif;
}
QComboBox {
    background-color: #ffffff;
    border: 1px solid #e0c9a0;
    border-radius: 8px;
    padding: 4px 12px;
    color: #4a3b2a;
}
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #ffd9a0;
    selection-color: #4a3b2a;
}
QCheckBox {
    color: #5a4a38;
    spacing: 8px;
}
QPushButton#settingsButton {
    background-color: #ffb25c;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: bold;
}
QPushButton#settingsButton:hover {
    background-color: #e8a04a;
}
#settingsClose {
    background: transparent; border: none; border-radius: 13px;
    color: #a0907f; font-size: 18px; font-weight: bold;
}
#settingsClose:hover { background-color: #f5e3c5; color: #e0553c; }
#miniButton {
    background-color: #ffeed3; border: 1px solid #f0c987;
    border-radius: 8px; color: #8a6a44; font-size: 13px;
}
#miniButton:hover { background-color: #ffd9a0; }
QPushButton#exitButton {
    background-color: #ff8a7a;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: bold;
}
QPushButton#exitButton:hover {
    background-color: #e87060;
}

/* ---------- 右键菜单 ---------- */
QMenu {
    background-color: rgba(255, 252, 246, 250);
    border: 1px solid #e8cfa5;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    color: #4a3b2a;
    padding: 6px 24px;
    border-radius: 6px;
    font-family: "Microsoft YaHei", sans-serif;
}
QMenu::item:selected {
    background-color: #ffe3b8;
}

/* ---------- 设置窗口滚动区（只有屏幕装不下时才出现滚动条） ---------- */
QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}
/* 只清滚动区视口的底色（视口对象名是 qt_scrollarea_viewport）。
   不能写 "> QWidget > QWidget"：那会连带命中设置面板本身，而且比
   #settingsPanel 的规则优先级更高，面板的奶油底色会被清成透明 */
QScrollArea#settingsScroll > QWidget#qt_scrollarea_viewport {
    background: transparent;
}
QScrollArea#settingsScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}
QScrollArea#settingsScroll QScrollBar::handle:vertical {
    background-color: #e8cfa5;
    border-radius: 5px;
    min-height: 32px;
}
QScrollArea#settingsScroll QScrollBar::handle:vertical:hover {
    background-color: #e07b39;
}
QScrollArea#settingsScroll QScrollBar::add-line:vertical,
QScrollArea#settingsScroll QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollArea#settingsScroll QScrollBar::add-page:vertical,
QScrollArea#settingsScroll QScrollBar::sub-page:vertical {
    background: transparent;
}
