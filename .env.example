# 复制为 .env 后按需填写；本文件不含任何真实密钥，可安全入库。
# 环境变量优先级说明：
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 由 framework/config.py 直接读取；
#   其余 Key 也可在桌面版「设置」界面填写，会持久化到 %APPDATA%\DesktopPet\user_settings.json。

# ---------- 对话模型 ----------
# 留空则桌面版走离线规则兜底（核心工具动作与演示链路仍可用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 可选能力 ----------
# 智谱开放平台：联网检索 web-search-pro
WEBSEARCH_API_KEY=
# 智谱开放平台：屏幕视觉理解，默认 glm-4.6v-flash
VISION_API_KEY=
# Pexels：PPT 自动配图，不填则退回纯排版
PEXELS_API_KEY=

# ---------- API 服务安全 ----------
# 设置后，所有请求必须带 X-API-Key: <token>（或 Authorization: Bearer <token>）。
# 未设置时服务只接受本机回环地址的请求；若要对外暴露，必须设置本项。
LINGLING_API_TOKEN=
# CORS 白名单，逗号分隔；默认仅本机调试台
LINGLING_API_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------- 本机文件访问 ----------
# read_doc / analyze_data 允许读取的额外目录，用系统路径分隔符（Windows 为 ; ）分隔。
# 默认允许：用户桌面 / 文档 / 下载、项目 data/、系统临时目录。
LINGLING_ALLOWED_PATHS=
# 是否允许打开白名单之外的任意本机程序（默认 0 = 只允许 APP_WHITELIST 内的应用）
LINGLING_ALLOW_ALL_APPS=0
